#!/bin/bash
# 本地质量门禁（v3.3.20）：push 前自动跑测试，防止坏版本被 cron 部署上线。
# e2e 默认不跑（耗时 ~7s 可接受时设 PREPUSH_E2E=1 启用）。
set -e
cd "$(git rev-parse --show-toplevel)"
echo "[pre-push] 静态测试…"
npm test --silent
echo "[pre-push] 语法检查…"
npm run test:syntax --silent
echo "[pre-push] diff 检查…"
git diff --check
if [ "${PREPUSH_E2E:-0}" = "1" ]; then
  echo "[pre-push] e2e 回归（chromium）…"
  npm run test:e2e --silent
  echo "[pre-push] e2e 回归（firefox）…"
  BROWSER=firefox npm run test:e2e --silent
fi
echo "[pre-push] 全部通过 ✓"
# v3.4.40：发版提醒（根因：并行线曾漏发 HF，落后 3 版无人发现）
cat <<'REMIND'
[pre-push] 提醒：push 完成后——
  1) 必推双远程：origin(GitHub，部署主源) + gitcode（gitee 已于 2026-11-16 移除）
  2) 部署只走 InstaBox 盒子（GitHub cron 自动；赶时间用 bash tools/deploy_box.sh）
  3) HF 不再部署（2026-11-16 规约）；完整步骤见 docs/发版流程.md
REMIND
